# syntax=docker/dockerfile:1.7
ARG BASE_REGISTRY=docker.io
ARG BASE_OWNER=codercom
ARG BASE_REPO=example-base
ARG BASE_TAG=ubuntu
ARG BASE_REF=${BASE_REGISTRY}/${BASE_OWNER}/${BASE_REPO}:${BASE_TAG}

ARG UV_VERSION=0.11.32

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${BASE_REF}

ARG TARGETARCH

COPY --from=uv /uv /uvx /usr/local/bin/

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

USER root

RUN --mount=type=cache,target=/var/cache/apt,id=base-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=base-apt-lib,sharing=locked \
    test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      bubblewrap \
      cmake \
      dnsutils \
      extrepo \
      fd-find \
      file \
      fzf \
      git-lfs \
      gh \
      iputils-ping \
      lsof \
      mtr-tiny \
      nano \
      net-tools \
      netcat-openbsd \
      ninja-build \
      p7zip-full \
      pkg-config \
      socat \
      strace \
      tcpdump \
      tmux \
      traceroute \
      tree \
      tzdata \
      zip \
      zstd \
    && wget "https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_amd64" \
      -O /usr/local/bin/yq \
    && echo "fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4  /usr/local/bin/yq" \
      | sha256sum -c - \
    && chmod +x /usr/local/bin/yq \
    && extrepo enable mise \
    && apt-get remove -y --auto-remove extrepo \
    && apt-get update \
    && apt-get install -y --no-install-recommends mise \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

# switch to runtime user
USER coder

ENV CODER_NODE_VERSION=22.23.2 \
    PATH="/home/coder/.local/share/mise/shims:${PATH}"

RUN mise use -g --pin "node@${CODER_NODE_VERSION}" \
    && node --version \
    && npm --version \
    && npx --version \
    && uv --version \
    && uvx --version \
    && yq --version
