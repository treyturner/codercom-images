# syntax=docker/dockerfile:1.7
ARG BASE_REGISTRY=docker.io
ARG BASE_OWNER=codercom
ARG BASE_REPO=example-base
ARG BASE_TAG=ubuntu
ARG BASE_REF=${BASE_REGISTRY}/${BASE_OWNER}/${BASE_REPO}:${BASE_TAG}

FROM ${BASE_REF}

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

USER root

RUN --mount=type=cache,target=/var/cache/apt,id=base-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=base-apt-lib,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      bubblewrap \
      cmake \
      dnsutils \
      extrepo \
      fd-find \
      file \
      fzf \
      git-lfs \
      gh \
      iputils-ping \
      lsof \
      mtr-tiny \
      nano \
      net-tools \
      netcat-openbsd \
      ninja-build \
      p7zip-full \
      pkg-config \
      ripgrep \
      socat \
      strace \
      tcpdump \
      tmux \
      traceroute \
      tree \
      uv \
      yq \
      zip \
      zstd \
    && extrepo enable mise \
    && apt-get remove -y --auto-remove extrepo \
    && apt-get update \
    && apt-get install -y --no-install-recommends mise \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

# switch to runtime user
USER coder
