# syntax=docker/dockerfile:1.7
ARG BASE_REGISTRY=docker.io
ARG BASE_OWNER=codercom
ARG BASE_REPO=example-base
ARG BASE_TAG=ubuntu
ARG BASE_REF=${BASE_REGISTRY}/${BASE_OWNER}/${BASE_REPO}:${BASE_TAG}

ARG UV_VERSION=0.11.32
ARG CODER_NODE_VERSION=22.23.2
ARG HOPPSCOTCH_MCP_VERSION=1.0.1

FROM node:${CODER_NODE_VERSION}-bookworm-slim AS hoppscotch-mcp

ARG HOPPSCOTCH_MCP_VERSION

RUN npm install --prefix /opt/hoppscotch-mcp \
      --omit=dev --ignore-scripts --no-audit --no-fund --save-exact \
      "@hoppscotch/mcp-server@${HOPPSCOTCH_MCP_VERSION}"

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${BASE_REF}

ARG TARGETARCH
ARG CODER_NODE_VERSION
ARG HOPPSCOTCH_MCP_VERSION

LABEL io.github.treyturner.hoppscotch-mcp.version="${HOPPSCOTCH_MCP_VERSION}"

COPY --from=uv /uv /uvx /usr/local/bin/

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

USER root

RUN --mount=type=cache,target=/var/cache/apt,id=base-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=base-apt-lib,sharing=locked \
    test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      bubblewrap \
      cmake \
      dnsutils \
      extrepo \
      fd-find \
      file \
      fzf \
      git-lfs \
      iputils-ping \
      lsof \
      mtr-tiny \
      nano \
      net-tools \
      netcat-openbsd \
      ninja-build \
      p7zip-full \
      pkg-config \
      socat \
      strace \
      tcpdump \
      tmux \
      traceroute \
      tree \
      tzdata \
      zip \
      zstd \
    && sudo mkdir -p -m 755 /etc/apt/keyrings \
    && out=$(mktemp) && wget -nv -O$out https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && cat $out | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && sudo mkdir -p -m 755 /etc/apt/sources.list.d \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && sudo apt update \
    && sudo apt install gh -y --no-install-recommends \
    && wget "https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_amd64" \
      -O /usr/local/bin/yq \
    && echo "fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4  /usr/local/bin/yq" \
      | sha256sum -c - \
    && chmod +x /usr/local/bin/yq \
    && extrepo enable mise \
    && apt-get remove -y --auto-remove extrepo \
    && apt-get update \
    && apt-get install -y --no-install-recommends mise \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && curl -fsSL https://github.com/hogklint/tailfin/releases/download/v0.3.0/tailfin_0.3.0_linux_amd64.tar.gz -o /tmp/tailfin.tar.gz \
    && echo 'ed3e2ae7cef60e4ff0d34912c94167aeea242b63e6bc3ef4c68714e9ddae6e26  /tmp/tailfin.tar.gz' \
      | sha256sum -c - \
    && tar -xzf /tmp/tailfin.tar.gz -O tailfin \
      | install -o root -g root -m 755 /dev/stdin /usr/local/bin/tailfin \
    && rm /tmp/tailfin.tar.gz

# switch to runtime user
USER coder

ENV CODER_NODE_VERSION=${CODER_NODE_VERSION} \
    PATH="/home/coder/.local/share/mise/shims:${PATH}"

RUN mise use -g --pin "node@${CODER_NODE_VERSION}" \
    && node --version \
    && npm --version \
    && npx --version \
    && uv --version \
    && uvx --version \
    && yq --version

# Keep both MCP dependencies and their interpreter outside the persistent home.
# COPY owns these files as root without duplicating them in a chown layer.
COPY --from=hoppscotch-mcp /opt/hoppscotch-mcp/ /opt/hoppscotch-mcp/
COPY --from=hoppscotch-mcp /usr/local/bin/node /opt/hoppscotch-mcp/bin/node
COPY hoppscotch/ /opt/hoppscotch-mcp/helper/

COPY --chmod=755 <<'EOF' /usr/local/bin/hoppscotch-mcp
#!/bin/sh
exec /opt/hoppscotch-mcp/bin/node /opt/hoppscotch-mcp/helper/launch.mjs "$@"
EOF

COPY --chmod=755 <<'EOF' /usr/local/bin/hoppscotch-mcp-auth
#!/bin/sh
exec /usr/bin/python3 -I /opt/hoppscotch-mcp/helper/credentials.py "$@"
EOF
