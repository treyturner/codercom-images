# syntax=docker/dockerfile:1.7
ARG BASE_REGISTRY=ghcr.io
ARG BASE_OWNER=treyturner
ARG BASE_REPO=codercom-playwright
ARG BASE_TAG=ubuntu
ARG BASE_REF=${BASE_REGISTRY}/${BASE_OWNER}/${BASE_REPO}:${BASE_TAG}

FROM ${BASE_REF}

ARG PLAYWRIGHT_VERSION

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_GC=1 \
    PLAYWRIGHT_VERSION=${PLAYWRIGHT_VERSION}

LABEL io.github.treyturner.playwright.version="${PLAYWRIGHT_VERSION}"

USER root

# Chromium is provided by the Playwright base image; add the remaining browsers.
RUN --mount=type=cache,target=/root/.local/share/mise,id=webdev-mise-data,sharing=locked \
    --mount=type=cache,target=/root/.cache/mise,id=webdev-mise-cache,sharing=locked \
    --mount=type=cache,target=/root/.npm,id=webdev-npm-cache,sharing=locked \
    if [[ ! "$PLAYWRIGHT_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then \
      echo "PLAYWRIGHT_VERSION must be provided as a GA version such as 1.63.0" >&2; \
      exit 1; \
    fi; \
    mise x "node@${CODER_NODE_VERSION}" -- \
      npx --yes "playwright@${PLAYWRIGHT_VERSION}" \
      install --with-deps firefox webkit \
    && chown -R coder:coder "$PLAYWRIGHT_BROWSERS_PATH"

USER coder
